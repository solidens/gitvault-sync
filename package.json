{
  "name": "gitvault-sync",
  "version": "0.1.4",
  "description": "Encrypted vault sync to a private GitHub repo",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "license": "MIT",
  "dependencies": {
    "node-diff3": "^3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^0.14.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.0"
  }
}
